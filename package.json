{
  "name": "cloakmail",
  "displayName": "Cloakmail",
  "version": "1.0.0",
  "description": "Privacy-first email aliases, self-hosted on Cloudflare.",
  "author": "Cloakmail contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "plasmo dev --src-path=.",
    "build": "plasmo build --src-path=.",
    "package": "plasmo package --src-path=.",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.7.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "plasmo": "^0.90.5",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3"
  },
  "manifest": {
    "manifest_version": 3,
    "action": {
      "default_title": "Cloakmail",
      "default_popup": "popup.html"
    },
    "permissions": [
      "activeTab",
      "storage",
      "tabs"
    ],
    "host_permissions": [
      "https://api.cloudflare.com/*"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "commands": {
      "_execute_action": {
        "suggested_key": {
          "default": "Alt+Shift+A"
        },
        "description": "Open Cloakmail"
      }
    }
  }
}
